{
  "name": "bottels",
  "version": "1.0.0",
  "description": "AQUAVIORA Packaged Water E-Commerce Platform - Cloudflare Deployment",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node server/tests/verify.js",
    "build": "cd client && npm install && npm run build && cd ..",
    "start": "npx wrangler dev",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "pages:deploy": "npx wrangler pages deploy public",
    "d1:init": "npx wrangler d1 execute bottels-db --file=./schema.sql"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "aquaviora",
    "bottels"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "googleapis": "^170.1.0",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
